+97 0 +92 0 +87 0 +84 0 +77 0 \n+72 0 +67 0 +64 0 +57 0 +52 0 +47 0 +44 0 +37 0 +32 0 +27 0 \n+24 0 +21 0 +19 0 +17 0 +15 0 +13 0 +11 0 +9 0 +7 0 +5 0 \n+3 0 *\nSo\n\n0100000\n+2 0 *\n\n+1 0 ","format":"OpenCascade-BRep","triangulation":false},"color":"#d7ad58","folderId":"83d02bf6-e3cb-42f8-9dec-440be9cadbca","id":"e804b55e-08f8-4c71-8ab2-ab02945edf0e","kind":"cad","layerId":"default","metadata":{"freecadSource":{"documentBase64":"","engineVersion":"1.1.4","script":{"code":"import math\nimport Part\nfrom FreeCAD import Vector\nn = int(parameters[\"blades\"])\nz0=176.0\nbase=doc.addObject(\"Part::Cylinder\",\"BaseDisc\")\nbase.Radius=56\nbase.Height=4\nbase.Placement.Base=Vector(0,-65,z0)\nhub=doc.addObject(\"Part::Cone\",\"Hub\")\nhub.Radius1=18\nhub.Radius2=12\nhub.Height=38\nhub.Placement.Base=Vector(0,-65,z0+3)\ndoc.recompute()\nsolids=[base.Shape,hub.Shape]\nfor i in range(n):\n    sections=[]\n    for j,(height,twist,outer) in enumerate([(0,0,52),(12,10,48),(25,23,40),(36,36,28)]):\n        a=math.radians(i*360.0/n+twist)\n        def p(r,t):\n            return Vector(r*math.cos(a+t),-65+r*math.sin(a+t),z0+3+height)\n        points=[p(22,-0.06),p(outer,-0.025),p(outer,0.035),p(22,0.12)]\n        wire=Part.makePolygon(points+[points[0]])\n        section=doc.addObject(\"Part::Feature\",\"Blade%02dSection%d\"%(i+1,j))\n        section.Shape=wire\n        sections.append(wire)\n    shape=Part.makeLoft(sections,True,False)\n    blade=doc.addObject(\"Part::Feature\",\"TwistedBlade%02d\"%(i+1))\n    blade.Shape=shape\n    solids.append(shape)\nfused=solids[0].multiFuse(solids[1:]).removeSplitter()\nbore=Part.makeCylinder(5,50,Vector(0,-65,z0-1))\nfinished=doc.addObject(\"Part::Feature\",\"FinishedImpeller\")\nfinished.Shape=fused.cut(bore).removeSplitter()\ndoc.recompute()\nresult=finished","gui":false,"name":"ATLAS · verdrehtes 9-Schaufel-Laufrad","parameters":{"blades":9},"version":1},"version":1},"notes":"Mit FreeCAD erstellt und geprüft. Die Maßhaltigkeit gegen